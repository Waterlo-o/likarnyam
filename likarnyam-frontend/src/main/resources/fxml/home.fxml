<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>
<BorderPane stylesheets="@../css/css.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.likarnyam.controller.HomeController">

    <left>
        <VBox prefWidth="80.0" styleClass="sidebar">
            <padding>
                <Insets top="20" bottom="20"/>
            </padding>

            <!-- Пустое пространство сверху -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Кнопки по центру -->
            <VBox alignment="CENTER" spacing="30.0">
                <Button styleClass="menu-btn" text="⌘" onAction="#navigateHome" />
                <Button styleClass="menu-btn" text="📅" onAction="#navigateSchedule" />
                <Button styleClass="menu-btn" text="👥" onAction="#navigatePatients" />
                <Button styleClass="menu-btn" text="📋" onAction="#navigateAppointments" />
                <Button styleClass="menu-btn" text="⚙" onAction="#navigateSettings" />
            </VBox>

            <!-- Пустое пространство снизу -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout внизу -->
            <HBox alignment="CENTER">
                <Button styleClass="menu-btn-logout" text="↪" onAction="#handleLogout" />
            </HBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" styleClass="main-content">
            <BorderPane.margin>
                <Insets bottom="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>

            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="400.0" promptText="Search" styleClass="search-bar" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="clockLabel" text="" styleClass="clock-label" />
                <HBox alignment="CENTER" spacing="10.0" styleClass="profile-badge">
                    <Circle fill="#ccc" radius="15.0" />
                    <Label fx:id="doctorNameLabel" text="">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                </HBox>
            </HBox>

            <TextFlow>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>

                <Text text="Good Morning " style="-fx-font-size: 32px;" />

                <Text fx:id="greetingText" text="" fill="#64B5F6" style="-fx-font-weight: bold; -fx-font-size: 32px;" />
            </TextFlow>

            <HBox spacing="30.0" VBox.vgrow="ALWAYS">

                <VBox spacing="20.0" HBox.hgrow="ALWAYS" prefWidth="600.0">

                    <AnchorPane prefHeight="240.0" prefWidth="600.0" styleClass="stats-card">

                        <VBox layoutX="40.0" layoutY="30.0" spacing="0.0">
                            <Label text="Visits for Today" textFill="#333333">
                                <font><Font size="22.0" /></font>
                            </Label>
                            <Label fx:id="totalVisitsLabel" text=" " textFill="BLACK">
                                <font><Font name="System Bold" size="64.0" /></font>
                            </Label>
                        </VBox>

                        <HBox layoutX="40.0" layoutY="155.0" spacing="15.0">
                            <VBox styleClass="mini-stat">
                                <Label text="Scheduled" />
                                <Label fx:id="scheduledLabel" text="">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                            </VBox>
                            <VBox styleClass="mini-stat">
                                <Label text="Completed" />
                                <Label fx:id="completedLabel" text="">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </AnchorPane>

                    <HBox spacing="20.0" VBox.vgrow="ALWAYS" styleClass="white-card">
                        <VBox.margin>
                            <Insets top="40.0" />
                        </VBox.margin>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" prefWidth="300.0">
                            <Label text="Patient List">
                                <font><Font name="System Bold" size="16.0" /></font>
                            </Label>
                            <ScrollPane fitToWidth="true" prefHeight="200"
                                        styleClass="patient-scroll">
                                <VBox fx:id="patientListContainer" spacing="10.0">
                                </VBox>
                            </ScrollPane>
                        </VBox>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" prefWidth="300.0">
                            <Label text="Consultation" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                            <VBox fx:id="consultationCard" styleClass="consultation-card"
                                  spacing="15.0" VBox.vgrow="ALWAYS">

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <Circle fx:id="consultationAvatar" fill="#d6f0ff" radius="25.0" />
                                    <VBox>
                                        <Label fx:id="consultationName" text="Select a patient">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Label fx:id="consultationInfo" text="Click on patient to see details"
                                               textFill="#888" />
                                    </VBox>
                                </HBox>
                                <Separator />
                                <GridPane hgap="10" vgap="10">
                                    <Label text="Reason:" GridPane.columnIndex="0"
                                           GridPane.rowIndex="0" textFill="#888"/>
                                    <Label fx:id="consultationReason" text="—"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                    <Label text="Notes:" GridPane.columnIndex="0"
                                           GridPane.rowIndex="1" textFill="#888"/>
                                    <Label fx:id="consultationNotes" text="—"
                                           wrapText="true"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                </GridPane>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="20.0" prefWidth="350.0">
                    <VBox styleClass="white-card" spacing="10.0" prefHeight="350.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Calendar" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="calMonthLabel" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                        </HBox>

                        <!-- Дни недели -->
                        <HBox spacing="2">
                            <Label text="Mo" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="Tu" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="We" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="Th" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="Fr" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="Sa" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="Su" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <VBox fx:id="homeCalendarGrid" spacing="2" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox styleClass="white-card" spacing="15.0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Upcoming" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="View All" textFill="#117c7f" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="event-badge">
                            <Circle fill="#6fa8dc" radius="20.0" />
                            <VBox>
                                <Label text="Monthly doctor's meet"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label text="8 April, 2021 | 04:00 PM" textFill="#888" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>
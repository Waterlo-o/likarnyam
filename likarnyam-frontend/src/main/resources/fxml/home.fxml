<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>
<BorderPane stylesheets="@../css/css.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.likarnyam.controller.HomeController">

    <left>
        <VBox alignment="CENTER" prefWidth="80.0" spacing="30.0" styleClass="sidebar">
            <padding>
                <Insets />
            </padding>
            <Button styleClass="menu-btn" text="⌘" />
            <Button styleClass="menu-btn" text="📅" />
            <Button styleClass="menu-btn" text="👥" />
            <Button styleClass="menu-btn" text="💬" />
            <Button styleClass="menu-btn" text="⚙" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" styleClass="main-content">
            <BorderPane.margin>
                <Insets bottom="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>

            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="400.0" promptText="Search" styleClass="search-bar" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="🔔" />
                <HBox alignment="CENTER" spacing="10.0" styleClass="profile-badge">
                    <Circle fill="#ccc" radius="15.0" />
                    <Label fx:id="doctorNameLabel" text="">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                </HBox>
            </HBox>

            <TextFlow>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>

                <Text text="Good Morning " style="-fx-font-size: 32px;" />

                <Text fx:id="greetingText" text="" fill="#64B5F6" style="-fx-font-weight: bold; -fx-font-size: 32px;" />
            </TextFlow>

            <HBox spacing="30.0" VBox.vgrow="ALWAYS">

                <VBox spacing="20.0" HBox.hgrow="ALWAYS" prefWidth="600.0">

                    <AnchorPane prefHeight="220.0" prefWidth="600.0" styleClass="stats-card">

                        <VBox layoutX="40.0" layoutY="30.0" spacing="0.0">
                            <Label text="Visits for Today" textFill="#333333">
                                <font><Font size="22.0" /></font>
                            </Label>
                            <Label fx:id="totalVisitsLabel" text="104" textFill="BLACK">
                                <font><Font name="System Bold" size="64.0" /></font>
                            </Label>
                        </VBox>

                        <HBox layoutX="40.0" layoutY="150.0" spacing="10.0">
                            <VBox styleClass="mini-stat">
                                <Label text="New Patients" />
                                <Label text="40">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                            </VBox>
                            <VBox styleClass="mini-stat">
                                <Label text="Old Patients" />
                                <Label text="64">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </AnchorPane>

                    <HBox spacing="20.0" VBox.vgrow="ALWAYS" styleClass="white-card">
                        <VBox.margin>
                            <Insets top="40.0" />
                        </VBox.margin>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" prefWidth="250.0">
                            <Label text="Patient List">
                                <font><Font name="System Bold" size="16.0" /></font>
                            </Label>
                            <VBox fx:id="patientListContainer" spacing="10.0">
                            </VBox>
                        </VBox>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" prefWidth="300.0">
                            <Label text="Consultation" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                            <VBox styleClass="consultation-card" spacing="15.0" VBox.vgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <Circle fill="#d6f0ff" radius="25.0" />
                                    <VBox>
                                        <Label text="Denzel White"><font><Font name="System Bold" size="16.0" /></font></Label>
                                        <Label text="Male - 28 Years 3 Months" textFill="#888" />
                                    </VBox>
                                </HBox>
                                <Separator />
                                <GridPane hgap="10" vgap="10">
                                    <Label text="Last Checked:" GridPane.columnIndex="0" GridPane.rowIndex="0" textFill="#888"/>
                                    <Label text="Dr Everly on 21 April 2021" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label text="Observation:" GridPane.columnIndex="0" GridPane.rowIndex="1" textFill="#888"/>
                                    <Label text="High fever and cough..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                    <Label text="Prescription:" GridPane.columnIndex="0" GridPane.rowIndex="2" textFill="#888"/>
                                    <Label text="Paracetamol - 2 times a day" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                </GridPane>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="20.0" prefWidth="350.0">
                    <VBox styleClass="white-card" spacing="10.0" prefHeight="350.0">
                        <Label text="Calendar">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Календарь" textFill="#aaa" alignment="CENTER" prefHeight="250.0" prefWidth="300.0"/>
                    </VBox>

                    <VBox styleClass="white-card" spacing="15.0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Upcoming" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="View All" textFill="#117c7f" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="event-badge">
                            <Circle fill="#6fa8dc" radius="20.0" />
                            <VBox>
                                <Label text="Monthly doctor's meet"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <Label text="8 April, 2021 | 04:00 PM" textFill="#888" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>
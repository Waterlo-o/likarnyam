<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="0"
      stylesheets="@../css/css.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.likarnyam.controller.AppointmentController"
      prefWidth="480" prefHeight="600"
      VBox.vgrow="ALWAYS"
      style="-fx-background-color: white; -fx-background-radius: 20;">

    <!-- Шапка -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: #64B5F6; -fx-background-radius: 20 20 0 0;
                 -fx-padding: 20;">
        <Label text="New Appointment"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="patientNameHeader" text=""
               style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="patient-scroll">
        <VBox spacing="20" style="-fx-padding: 24;">

            <!-- Выбор даты -->
            <VBox spacing="10">
                <Label text="Select Date"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #4a5568;"/>

                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="prevMonthBtn" text="◀" styleClass="btn-nav"
                            onAction="#prevMonth"/>
                    <Label fx:id="monthLabel" text=""
                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                  -fx-min-width: 130; -fx-alignment: center;"/>
                    <Button fx:id="nextMonthBtn" text="▶" styleClass="btn-nav"
                            onAction="#nextMonth"/>
                </HBox>

                <!-- Дни недели -->
                <HBox spacing="4">
                    <Label text="Mo" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Tu" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="We" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Th" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Fr" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Sa" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Su" styleClass="cal-weekday" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <VBox fx:id="miniCalendarGrid" spacing="4"/>
            </VBox>

            <Separator/>

            <!-- Выбор слота -->
            <VBox spacing="8">
                <Label text="Select Time Slot"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #4a5568;"/>
                <Label fx:id="noSlotsLabel" text="Select a date to see available slots"
                       style="-fx-text-fill: #a0aec0; -fx-font-size: 12px;"/>
                <FlowPane fx:id="slotsContainer" hgap="8" vgap="8"/>
            </VBox>

            <Separator/>

            <!-- Причина -->
            <VBox spacing="8">
                <Label text="Reason *"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #4a5568;"/>
                <TextField fx:id="reasonField"
                           promptText="Enter reason for visit..."
                           styleClass="login-input"/>
            </VBox>

            <!-- Заметки -->
            <VBox spacing="8">
                <Label text="Notes"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #4a5568;"/>
                <TextArea fx:id="notesField"
                          promptText="Additional notes..."
                          prefHeight="70"
                          style="-fx-background-color: #f7fafc;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-padding: 10;"/>
            </VBox>

            <!-- Кнопки -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancel" styleClass="btn-back"
                        onAction="#handleCancel"/>
                <Button fx:id="bookBtn" text="Book Appointment"
                        styleClass="btn-primary"
                        onAction="#handleBook"/>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>